// ═══════════════════════════════════════════════════════════════
// Pattern Matching in Obfusku
// Demonstrates: Literal patterns, boolean patterns, and wildcards
// (user-chosen names may be glyphs or ordinary words — both are legal)
// ═══════════════════════════════════════════════════════════════

// Integer pattern matching with wildcards
λδescribe(ν: ⟁): ⌘ →
    ⟡ ν {
        0 → "zero"
        ⟢ 1 → "one"
        ⟢ 2 → "two"
        ⟢ _ → "many"
    }

// Boolean pattern matching
λβoolToString(β: ○): ⌘ →
    ⟡ β {
        ◉ → "true"
        ⟢ ◎ → "false"
    }

// Nested pattern matching
λclassify(ν: ⟁): ⌘ →
    ⟡ (ν > 0) {
        ◉ → "positive"
        ⟢ ◎ → ⟡ (ν < 0) {
            ◉ → "negative"
            ⟢ ◎ → "zero"
        }
    }

zeroStr ≔ δescribe(0)
manyStr ≔ δescribe(42)
boolStr ≔ βoolToString(◉)
classStr ≔ classify(0 ☠︎ 5)

result ≔ classStr
❧
