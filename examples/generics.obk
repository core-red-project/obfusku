// ═══════════════════════════════════════════════════════════════
// Generics and Polymorphism in Obfusku
// Demonstrates: Generic functions, the ambient Optional<T>, and
// Hindley-Milner type inference
// ═══════════════════════════════════════════════════════════════

// Generic identity function reusing type parameter 't'
λidentity(x: t): t → x

// Function unwrapping an ambient Optional<Int> with a fallback default
λunwrapOr(opt: Optional ▷ ⟁, fallback: ⟁): ⟁ →
    ⟡ opt {
        ⧫(v) → v
        ⟢ ⦰ → fallback
    }

// Polymorphic identity instantiated at multiple types
idInt ≔ identity(42)
idStr ≔ identity("polymorphic")

// Ambient Optional constructor instances
optInt ≔ ⧫(100)
optEmpty ≔ ⦰

// Unwrapping options
res1 ≔ unwrapOr(optInt, 0)
res2 ≔ unwrapOr(optEmpty, 7)

result ≔ res1 ✚ res2
❧
